# Garmin Connect account credentials
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=changeme

# Google Sheets
# Path to a Google service account JSON key file (share the target Sheet with its client_email)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SHEET_ID=paste_sheet_id_here

# Optional: how many days back to sync on first run
INITIAL_SYNC_DAYS=90
